          },
          "event": [{"listen":"test","script":{"exec":["pm.test('Status 404', () => pm.response.to.have.status(404));"],"type":"text/javascript"}}],
          "response": []
        }
      ]
    },

    {
      "name": "🎯 Demo Flow (run in order)",
      "description": "Run these 4 requests in sequence for a complete end-to-end demo. Step 2 auto-saves the claim_id.",
      "item": [
        {
          "name": "1. Check Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {"raw": "{{claimiq_url}}/health", "host": ["{{claimiq_url}}"], "path": ["health"]}
          },
          "event": [{"listen":"test","script":{"exec":["pm.test('ClaimIQ is healthy', () => pm.response.to.have.status(200));","console.log('✅ Step 1 done — services healthy');"],"type":"text/javascript"}}],
          "response": []
        },
        {
          "name": "2. Load Policy into Graph",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "url": {"raw": "{{policylens_url}}/policies", "host": ["{{policylens_url}}"], "path": ["policies"]},
            "body": {
              "mode": "raw",
              "raw": "{\n  \"policy_id\": \"HC-STD-2024\",\n  \"policy_name\": \"Standard Health Policy 2024\",\n  \"wording_text\": \"STANDARD HEALTH INSURANCE POLICY\\n\\nSECTION 3: COVERAGES\\n3.1 In-patient Hospitalization: Expenses for hospitalization exceeding 24 hours.\\n3.2 High-Value Claims: Claims above INR 5,00,000 require senior adjuster review.\\n\\nSECTION 4: EXCLUSIONS\\n4.1 Pre-existing Conditions: No claim payable for pre-existing diseases within first 36 months.\\n4.2 Waiting Period: No benefits payable within first 30 days.\"\n}",
              "options": {"raw": {"language": "json"}}
            }
          },
          "event": [{"listen":"test","script":{"exec":["const ok = pm.response.status === 201 || pm.response.status === 409;","pm.test('Policy loaded (201) or already exists (409)', () => pm.expect(ok).to.be.true);","console.log('✅ Step 2 done — policy in graph, nodes:', pm.response.json().nodes_added || '(already loaded)');"],"type":"text/javascript"}}],
          "response": []
        },
        {
          "name": "3. Submit FNOL Claim",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "url": {"raw": "{{claimiq_url}}/claims", "host": ["{{claimiq_url}}"], "path": ["claims"]},
            "body": {
              "mode": "raw",
              "raw": "{\n  \"policy_id\": \"HC-STD-2024\",\n  \"insured_name\": \"Rajesh Kumar\",\n  \"claim_type\": \"health\",\n  \"amount_claimed\": 750000,\n  \"incident_date\": \"2024-01-10\",\n  \"reported_date\": \"2024-01-12\",\n  \"narrative\": \"Patient admitted for cardiac surgery at Apollo Hospital, Chennai.\"\n}",
              "options": {"raw": {"language": "json"}}
            }
          },
          "event": [{"listen":"test","script":{"exec":["pm.test('FNOL accepted (201)', () => pm.response.to.have.status(201));","const j = pm.response.json();","if (j.claim?.id) {","  pm.collectionVariables.set('claim_id', j.claim.id);","  console.log('✅ Step 3 done — claim_id saved:', j.claim.id);","}","console.log('   Queue:', j.routing_decision?.assigned_queue);","console.log('   Reserve: ₹', j.routing_decision?.reserve_suggestion);","console.log('   Justification ID:', j.routing_decision?.policylens_justification_id);"],"type":"text/javascript"}}],
          "response": []
        },
        {
          "name": "4. Get Full Decision + Audit Trail",
          "request": {
            "method": "GET",
            "header": [],
            "url": {"raw": "{{claimiq_url}}/claims/{{claim_id}}/decision", "host": ["{{claimiq_url}}"], "path": ["claims","{{claim_id}}","decision"]}
          },
