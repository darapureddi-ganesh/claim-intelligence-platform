            "url": {"raw": "{{claimiq_url}}/claims", "host": ["{{claimiq_url}}"], "path": ["claims"]},
            "body": {
              "mode": "raw",
              "raw": "{\n  \"policy_id\": \"HC-STD-2024\",\n  \"insured_name\": \"Ananya Sharma\",\n  \"claim_type\": \"health\",\n  \"amount_claimed\": 8000,\n  \"incident_date\": \"2024-03-01\",\n  \"reported_date\": \"2024-03-02\",\n  \"narrative\": \"Minor outpatient consultation. Pharmacy bills attached.\"\n}",
              "options": {"raw": {"language": "json"}}
            }
          },
          "event": [{"listen":"test","script":{"exec":["pm.test('Status 201', () => pm.response.to.have.status(201));","const j = pm.response.json();","if (j.claim?.id) pm.collectionVariables.set('claim_id', j.claim.id);","console.log('Queue:', j.routing_decision?.assigned_queue);","console.log('Overall risk (expect low):', j.routing_decision?.severity_score);"],"type":"text/javascript"}}],
          "response": []
        },
        {
          "name": "Get Claim (uses saved claim_id)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {"raw": "{{claimiq_url}}/claims/{{claim_id}}", "host": ["{{claimiq_url}}"], "path": ["claims","{{claim_id}}"]}
          },
          "event": [{"listen":"test","script":{"exec":["pm.test('Status 200', () => pm.response.to.have.status(200));","pm.test('Has claim data', () => pm.expect(pm.response.json().claim).to.be.an('object'));"],"type":"text/javascript"}}],
          "response": []
        },
        {
          "name": "Get Claim Decision (uses saved claim_id)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {"raw": "{{claimiq_url}}/claims/{{claim_id}}/decision", "host": ["{{claimiq_url}}"], "path": ["claims","{{claim_id}}","decision"]}
          },
          "event": [{"listen":"test","script":{"exec":["pm.test('Status 200', () => pm.response.to.have.status(200));","const j = pm.response.json();","pm.test('Has routing_decision', () => pm.expect(j.routing_decision).to.be.an('object'));","pm.test('Has policylens_justification_id (IRDAI mandate)', () => pm.expect(j.routing_decision.policylens_justification_id).to.be.a('string').and.not.empty);","pm.test('Has audit_trail', () => pm.expect(j.audit_trail).to.be.an('array').with.length.above(0));","const auditActions = j.audit_trail.map(a => a.action);","pm.test('Audit includes POLICYLENS_QUERIED', () => pm.expect(auditActions).to.include('POLICYLENS_QUERIED'));","pm.test('Audit includes DECISION_PERSISTED', () => pm.expect(auditActions).to.include('DECISION_PERSISTED'));","console.log('Full audit trail:', auditActions.join(' → '));","console.log('Justification ID:', j.routing_decision?.policylens_justification_id);"],"type":"text/javascript"}}],
