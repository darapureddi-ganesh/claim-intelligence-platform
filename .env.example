# ── Google AI (pick one) ────────────────────────────────────────────────
# A) Gemini API key from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# B) Vertex AI with Application Default Credentials (no key)
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=my-project
# GOOGLE_CLOUD_LOCATION=global
# LIVE_LOCATION=us-central1

# ── Models (override with newer IDs from AI Studio; see scripts/list_models.py)
GEMINI_MODEL=gemini-3.8-flash
GEMINI_REASONING_MODEL=gemini-3.8-flash
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_LIVE_VOICE=Kore
NANO_BANANA_MODEL=gemini-nano-banana-2.1
GEMMA_MODEL=gemma-4-26b-a4b-it
# Self-hosted Gemma (vLLM/Ollama, OpenAI-compatible) — keeps PII in your VPC
# GEMMA_ENDPOINT=http://gemma.internal:8000

# ── Storage for the Cloud Run app: memory | firestore
STORAGE_BACKEND=memory

# ── Original Phase 1 stack (Postgres + Redis + separate services)
DATABASE_URL=postgresql+asyncpg://claimiq:claimiq_dev@localhost:5432/claimiq
DATABASE_SYNC_URL=postgresql+psycopg2://claimiq:claimiq_dev@localhost:5432/claimiq
REDIS_URL=redis://localhost:6379/0
POLICYLENS_URL=http://localhost:8001
SECRET_KEY=change-me-in-production
LOG_LEVEL=INFO
